{
  "name": "chores",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @chores/web",
    "build": "npm run build -w @chores/web",
