    "e2e": "bash scripts/e2e-emulator.sh"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
